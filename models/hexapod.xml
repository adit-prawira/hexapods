<mujoco model="hexapod">
  <!-- Radian units: joint ranges, ctrl ranges, and euler angles below are
       radians. MJCF defaults to degrees — leaving that default silently
       welds every joint to a ~degree-wide range. -->
  <compiler angle="radian"/>
  <!-- Determinism contract: fixed timestep, nothing random. -->
  <option timestep="0.002"/>
  <statistic center="0 0 0.2" extent="1.2"/>

  <!-- Contact policy: floor is bit 1, robot is bit 2. Robot geoms collide
       with the floor but never with each other. -->
  <default>
    <joint damping="0.5" armature="0.01"/>
    <default class="trunk">
      <geom contype="2" conaffinity="1"/>
    </default>
    <default class="leg">
      <geom contype="2" conaffinity="1" density="200"/>
    </default>
    <default class="coxa">
      <joint range="-0.7 0.7"/>
      <position kp="30" kv="0.8" ctrlrange="-0.7 0.7"/>
    </default>
    <default class="femur">
      <joint range="-1.4 1.4"/>
      <position kp="60" kv="1.2" ctrlrange="-1.4 1.4"/>
    </default>
    <default class="tibia">
      <joint range="0.1 3.0"/>
      <position kp="60" kv="1.2" ctrlrange="0.1 3.0"/>
    </default>
  </default>

  <asset>
    <mesh name="trunk_mesh" file="trunk.obj"/>
    <mesh name="trunk_spine_mesh" file="trunk.obj" scale="0.45 0.5 0.4"/>
    <mesh name="femur_mesh" file="femur.obj"/>
    <mesh name="tibia_mesh" file="tibia.obj"/>
    <mesh name="coxa_mesh" file="femur.obj" scale="0.4375 1 1"/>
    <mesh name="foot_mesh" file="foot.obj"/>
    <material name="carbon" rgba="0.07 0.08 0.10 1" metallic="0.5" roughness="0.3"/>
    <material name="gunmetal" rgba="0.35 0.37 0.40 1" metallic="0.8" roughness="0.4"/>
    <material name="servo" rgba="0.15 0.16 0.18 1" metallic="0.6" roughness="0.35"/>
    <material name="amber" rgba="1.0 0.45 0.05 1" metallic="0.2" roughness="0.5"/>
    <texture name="floor_checker" type="2d" builtin="checker" rgb1="0.24 0.25 0.27"
             rgb2="0.20 0.21 0.23" width="512" height="512"/>
    <material name="floor_mat" texture="floor_checker" texuniform="true" texrepeat="8 8"/>
  </asset>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
  </visual>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light name="fill" pos="-2 -1.5 2.5" dir="0.5 0.4 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"
          contype="1" conaffinity="2"/>

    <body name="trunk" pos="0 0 0.30">
      <freejoint name="root"/>
      <geom name="trunk_geom" class="trunk" type="mesh" mesh="trunk_mesh"
            mass="1.6" material="carbon"/>
      <geom name="trunk_spine" class="trunk" type="mesh" mesh="trunk_spine_mesh"
            pos="0 0 0.072" mass="0.1" material="gunmetal"/>

      <!-- Bilateral layout: one leg on each side face of the octagon trunk
           (4 chamfer faces + 2 long side faces); the nose (+x) and tail (-x)
           faces are bare. Leg 0 = front-right (45 deg), 1 = right (90),
           2 = rear-right (135), 3 = rear-left (225), 4 = left (270),
           5 = front-left (315). Each leg is a
           coxa (yaw, z axis) -> femur (pitch, y axis) -> tibia (pitch, y
           axis) chain along the leg-local +x axis. Joint zeros = straight
           legs; the standing pose is set by actuator targets in C++. -->
      <body name="leg0" pos="0.23 0.10 0" euler="0 0 0.7854">
        <body name="leg0_coxa">
          <joint name="leg0_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg0_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg0_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg0_femur" pos="0.07 0 0">
            <joint name="leg0_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg0_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg0_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg0_tibia" pos="0.16 0 0">
              <joint name="leg0_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg0_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg0_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg0_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
      <body name="leg1" pos="0 0.13 0" euler="0 0 1.5708">
        <body name="leg1_coxa">
          <joint name="leg1_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg1_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg1_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg1_femur" pos="0.07 0 0">
            <joint name="leg1_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg1_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg1_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg1_tibia" pos="0.16 0 0">
              <joint name="leg1_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg1_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg1_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg1_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
      <body name="leg2" pos="-0.23 0.10 0" euler="0 0 2.3562">
        <body name="leg2_coxa">
          <joint name="leg2_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg2_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg2_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg2_femur" pos="0.07 0 0">
            <joint name="leg2_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg2_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg2_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg2_tibia" pos="0.16 0 0">
              <joint name="leg2_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg2_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg2_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg2_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
      <body name="leg3" pos="-0.23 -0.10 0" euler="0 0 3.9270">
        <body name="leg3_coxa">
          <joint name="leg3_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg3_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg3_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg3_femur" pos="0.07 0 0">
            <joint name="leg3_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg3_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg3_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg3_tibia" pos="0.16 0 0">
              <joint name="leg3_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg3_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg3_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg3_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
      <body name="leg4" pos="0 -0.13 0" euler="0 0 4.7124">
        <body name="leg4_coxa">
          <joint name="leg4_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg4_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg4_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg4_femur" pos="0.07 0 0">
            <joint name="leg4_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg4_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg4_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg4_tibia" pos="0.16 0 0">
              <joint name="leg4_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg4_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg4_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg4_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
      <body name="leg5" pos="0.23 -0.10 0" euler="0 0 5.4978">
        <body name="leg5_coxa">
          <joint name="leg5_coxa" class="coxa" type="hinge" axis="0 0 1"/>
          <geom name="leg5_coxa_geom" class="leg" type="mesh" mesh="coxa_mesh" mass="0.025"
                material="gunmetal"/>
          <geom name="leg5_coxa_servo" class="leg" type="cylinder" pos="0 0 0"
                size="0.028 0.035" mass="0.03" material="servo"/>
          <body name="leg5_femur" pos="0.07 0 0">
            <joint name="leg5_femur" class="femur" type="hinge" axis="0 1 0"/>
            <geom name="leg5_femur_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                  pos="0 0 0" size="0.026 0.030" mass="0.03" material="servo"/>
            <geom name="leg5_femur_geom" class="leg" type="mesh" mesh="femur_mesh" mass="0.05"
                  material="gunmetal"/>
            <body name="leg5_tibia" pos="0.16 0 0">
              <joint name="leg5_tibia" class="tibia" type="hinge" axis="0 1 0"/>
              <geom name="leg5_tibia_servo" class="leg" type="cylinder" euler="1.5708 0 0"
                    pos="0 0 0" size="0.024 0.028" mass="0.03" material="servo"/>
              <geom name="leg5_tibia_geom" class="leg" type="mesh" mesh="tibia_mesh" mass="0.05"
                    material="gunmetal"/>
              <geom name="leg5_foot" class="leg" type="mesh" mesh="foot_mesh" pos="0.26 0 0" mass="0.02"
                    friction="1.5 0.005 0.0001" material="amber"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="leg0_coxa" class="coxa" joint="leg0_coxa"/>
    <position name="leg0_femur" class="femur" joint="leg0_femur"/>
    <position name="leg0_tibia" class="tibia" joint="leg0_tibia"/>
    <position name="leg1_coxa" class="coxa" joint="leg1_coxa"/>
    <position name="leg1_femur" class="femur" joint="leg1_femur"/>
    <position name="leg1_tibia" class="tibia" joint="leg1_tibia"/>
    <position name="leg2_coxa" class="coxa" joint="leg2_coxa"/>
    <position name="leg2_femur" class="femur" joint="leg2_femur"/>
    <position name="leg2_tibia" class="tibia" joint="leg2_tibia"/>
    <position name="leg3_coxa" class="coxa" joint="leg3_coxa"/>
    <position name="leg3_femur" class="femur" joint="leg3_femur"/>
    <position name="leg3_tibia" class="tibia" joint="leg3_tibia"/>
    <position name="leg4_coxa" class="coxa" joint="leg4_coxa"/>
    <position name="leg4_femur" class="femur" joint="leg4_femur"/>
    <position name="leg4_tibia" class="tibia" joint="leg4_tibia"/>
    <position name="leg5_coxa" class="coxa" joint="leg5_coxa"/>
    <position name="leg5_femur" class="femur" joint="leg5_femur"/>
    <position name="leg5_tibia" class="tibia" joint="leg5_tibia"/>
  </actuator>
</mujoco>
